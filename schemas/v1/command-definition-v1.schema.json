{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after.invalid/schemas/v1/command-definition-v1.schema.json",
  "title": "AFTER command definition, version 1",
  "description": "Closed declarative direct-argv input for the built-in command runner. Go validation additionally enforces byte decoding, cross-field and execution-safety rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "name",
    "platform",
    "image",
    "cases",
    "repetitions",
    "limits",
    "comparison"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "command" },
    "name": { "$ref": "#/$defs/name" },
    "platform": { "enum": ["linux/amd64", "linux/arm64"] },
    "image": { "$ref": "#/$defs/pinned_image" },
    "build_argv": {
      "type": ["array", "null"],
      "maxItems": 64,
      "items": { "$ref": "#/$defs/argv_item" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/case" }
    },
    "repetitions": { "type": "integer", "minimum": 1, "maximum": 5 },
    "limits": { "$ref": "#/$defs/limits" },
    "comparison": { "$ref": "#/$defs/comparison" }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "pinned_image": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/:+-]+@sha256:[a-f0-9]{64}$"
    },
    "argv_item": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "not": { "pattern": "[\\x00\\r\\n]" }
    },
    "environment_entry": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[A-Z][A-Z0-9_]{0,63}=[^\\x00\\r\\n]*$"
    },
    "base64_bytes": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 21848,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "argv", "stdin_base64", "environment"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "title": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/argv_item" }
        },
        "stdin_base64": { "$ref": "#/$defs/base64_bytes" },
        "environment": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/environment_entry" }
        },
        "input_files": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/input_file" }
        }
      }
    },
    "input_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_base64"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "content_base64": { "$ref": "#/$defs/base64_bytes" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seconds", "output_bytes", "preparation_seconds"],
      "properties": {
        "seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "output_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "preparation_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": { "enum": ["text", "json"] },
        "stderr": { "enum": ["text", "json"] }
      }
    }
  }
}
