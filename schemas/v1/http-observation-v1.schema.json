{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://after.invalid/schemas/v1/http-observation-v1.schema.json",
  "title": "AFTER HTTP-service observation artifact, version 1",
  "description": "JSON body emitted by the trusted paired-run observer. Applicability, case binding, request counts and endpoint provenance are checked by Go against the frozen definition and receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "case_id", "responses", "provider_calls"],
  "properties": {
    "version": { "const": 1 },
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "seconds": { "type": "integer", "minimum": 0, "maximum": 31536000 },
    "responses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/response" }
    },
    "provider_calls": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/provider_call" }
    }
  },
  "$defs": {
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "body"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "body": { "type": "string", "maxLength": 4096 }
      }
    },
    "provider_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "endpoint", "destination", "method", "path", "key", "body"],
      "properties": {
        "at": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "endpoint": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "destination": { "type": "string", "pattern": "^127\\.0\\.0\\.1:1808[1-4]$" },
        "method": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Z]+$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/" },
        "key": { "type": "string", "maxLength": 128 },
        "body": { "type": "string", "maxLength": 4096 }
      }
    }
  }
}
